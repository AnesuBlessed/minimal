# =============================================================================
#  MINIMAL MAKO — LIGHTWEIGHT WAYLAND NOTIFICATIONS
# =============================================================================
#  - Ultra-lean C-native notification daemon
#  - Minimalist floating dark glass styling with sage-olive accent
# =============================================================================

font=JetBrainsMono Nerd Font 10
background-color=#16161af0
text-color=#e4e4e7
width=320
height=110
margin=12
padding=10
border-size=1
border-color=#b8c47088
border-radius=10
default-timeout=4000
group-by=summary
icons=1
max-icon-size=48
layer=overlay

[urgency=low]
border-color=#252528cc
default-timeout=2500

[urgency=normal]
border-color=#b8c47088
default-timeout=4000

[urgency=critical]
border-color=#e06c75ee
text-color=#ffffff
default-timeout=0

# Replacement-tagged OSDs stay separate from normal notification history.
[app-name=minimal-osd]
anchor=bottom-center
margin=0,0,64,0
width=300
height=52
padding=14
border-size=1
border-radius=10
background-color=#181822f5
text-color=#f4f4f5
border-color=#b8c47088
progress-color=over #b8c47033
format=%s
icons=0
history=0
group-by=none
default-timeout=1200
ignore-timeout=1

# Do Not Disturb Mode
[mode=dnd]
invisible=1

[mode=dnd urgency=critical]
invisible=0

