# =============================================================================
#  MINIMAL — MAKO (OBSIDIAN GLASS NOTIFICATION & OSD DAEMON)
# =============================================================================

font=JetBrainsMono Nerd Font 10
background-color=#0f1a2af4
text-color=#cce1ff
border-color=#506182
border-size=2
border-radius=12
progress-color=#aac7f0
padding=12,18
margin=12
default-timeout=3000
group-by=summary
anchor=top-right
layer=overlay
max-icon-size=40
icon-location=left

[urgency=low]
border-color=#506182
default-timeout=2000

[urgency=normal]
border-color=#7a92c2
default-timeout=3000

[urgency=critical]
border-color=#f38ba8
default-timeout=0
text-color=#ffccd8

[mode=osd]
default-timeout=1500
anchor=top-right
padding=10,16
