{
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "rotate": 0,
    "format-muted": "󰖁",
    "on-click": "pavucontrol",
    "on-click-right": "\"$MINIMAL_ROOT/scripts/volume.sh\" --toggle-mute",
    "on-scroll-up": "\"$MINIMAL_ROOT/scripts/volume.sh\" --inc",
    "on-scroll-down": "\"$MINIMAL_ROOT/scripts/volume.sh\" --dec",
    "tooltip-format": "{icon} {desc} // {volume}%",
    "scroll-step": 5,
    "max-volume": 100,
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ]
    }
  }
}
