{
  "network": {
    "tooltip": true,
    "format-wifi": " ",
    "rotate": 0,
    "format-ethernet": "󰈀 ",
    "tooltip-format": "Network: <big><b>{essid}</b></big>\nSignal: <b>{signalStrength}%</b>\nIP: <b>{ipaddr}</b>",
    "format-linked": "󰈀 {ifname} (No IP)",
    "format-disconnected": "󰤮 ",
    "tooltip-format-disconnected": "Disconnected\nLeft-click: Network Settings\nRight-click: Toggle Wi-Fi",
    "on-click": "nm-connection-editor",
    "on-click-right": "rfkill toggle wifi",
    "interval": 2
  }
}
