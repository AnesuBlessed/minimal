{
  "custom/mako": {
    "format": "{icon}",
    "format-icons": {
      "default": "\udb80\udc9a",
      "dnd": "\udb80\udc9b"
    },
    "tooltip": true,
    "tooltip-format": "Notifications (Mako)\nLeft: Toggle DND | Middle: Dismiss All | Right: Restore",
    "exec": "makoctl mode 2>/dev/null | grep -q 'do-not-disturb' && echo '{\"text\":\"\udb80\udc9b\",\"alt\":\"dnd\",\"class\":\"dnd\"}' || echo '{\"text\":\"\udb80\udc9a\",\"alt\":\"default\",\"class\":\"default\"}'",
    "return-type": "json",
    "interval": 2,
    "on-click": "makoctl mode -t do-not-disturb",
    "on-click-middle": "makoctl dismiss -a",
    "on-click-right": "makoctl restore",
    "exec-if": "command -v makoctl >/dev/null"
  }
}
