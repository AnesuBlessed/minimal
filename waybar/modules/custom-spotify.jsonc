{
  "custom/spotify": {
    "exec": "playerctl --player=spotify metadata --format '{\"text\":\"{{title}} - {{artist}}\",\"tooltip\":\"{{album}} ({{status}})\",\"class\":\"{{status}}\"}' 2>/dev/null",
    "format": " {}",
    "rotate": 0,
    "return-type": "json",
    "on-click": "playerctl play-pause --player spotify",
    "on-click-middle": "playerctl stop --player spotify",
    "on-scroll-up": "playerctl volume 0.05+ --player spotify",
    "on-scroll-down": "playerctl volume 0.05- --player spotify",
    "tooltip": true,
    "interval": 2
  }
}
