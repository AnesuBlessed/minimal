{
  "group/volumecontrol": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 120,
      "children-class": "volumecontrol-drawer",
      "transition-left-to-right": false,
      "click-to-reveal": false
    },
    "modules": ["pulseaudio#output", "pulseaudio#input"]
  },
  "pulseaudio#input": {
    "format": "<span size='medium'>{format_source}</span> {source_volume}%",
    "rotate": 0,
    "format-source": "󰍬",
    "format-source-muted": "󰍭",
    "on-click": "\"${MINIMAL_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/minimal}/scripts/open-app.sh\" audio",
    "on-click-middle": "\"${MINIMAL_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/minimal}/scripts/media.sh\" mic mute",
    "on-scroll-up": "\"${MINIMAL_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/minimal}/scripts/media.sh\" mic up",
    "on-scroll-down": "\"${MINIMAL_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/minimal}/scripts/media.sh\" mic down",
    "tooltip-format": "{format_source} {source_desc} // {source_volume}%",
    "scroll-step": 5
  },

  "pulseaudio#output": {
    "format": "<span size='medium'>{icon}</span> {volume}%",
    "rotate": 0,
    "format-muted": "<span size='large'>󰖁</span> {volume}%",
    "on-click": "\"${MINIMAL_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/minimal}/scripts/open-app.sh\" audio",
    "on-click-right": "\"${MINIMAL_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/minimal}/scripts/open-app.sh\" audio",
    "on-click-middle": "\"${MINIMAL_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/minimal}/scripts/media.sh\" volume mute",
    "on-scroll-up": "\"${MINIMAL_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/minimal}/scripts/media.sh\" volume up",
    "on-scroll-down": "\"${MINIMAL_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/minimal}/scripts/media.sh\" volume down",
    "tooltip-format": "{icon} {desc} // {volume}%",
    "scroll-step": 5,
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""]
    }
  }
}
