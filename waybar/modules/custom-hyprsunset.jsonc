{
    "custom/hyprsunset": {
        "return-type": "json",
        "format": "{0} ",
        "exec": "true",
        "rotate": 0,
        "on-click": "hyprsunset --toggle || true",
        "on-click-right": "pkill hyprsunset || true",
        "interval": "once",
        "tooltip": true,
        "signal": 19
    }
}
