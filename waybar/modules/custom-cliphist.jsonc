{
    "custom/cliphist": {
        "format": "",
        "rotate": 0,
        "tooltip-format": "Left: Clipboard Manager | Right: Delete Entries | Middle: Wipe",
        "on-click": "$MINIMAL_ROOT/scripts/clipboard.sh",
        "on-click-right": "$MINIMAL_ROOT/scripts/clipboard.sh --delete",
        "on-click-middle": "$MINIMAL_ROOT/scripts/clipboard.sh --wipe",
        "interval": 86400,
        "tooltip": true
    }
}
