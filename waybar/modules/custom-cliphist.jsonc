{
  "custom/cliphist": {
    "format": "󰅌",
    "rotate": 0,
    "tooltip-format": "Clipboard History (Click to browse, Right-click to wipe)",
    "on-click": "${MINIMAL_ROOT:-$HOME/.config/minimal}/scripts/clipboard.sh",
    "on-click-right": "cliphist wipe && notify-send -i edit-clear 'Clipboard' 'Clipboard history cleared'",
    "tooltip": true
  }
}