{
  "custom/settings": {
    "format": "󰒓",
    "rotate": 0,
    "tooltip": true,
    "tooltip-format": "Control Center (Left-click) | Displays (Right-click)",
    "on-click": "\"${MINIMAL_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/minimal}/scripts/control-center.sh\"",
    "on-click-right": "\"${MINIMAL_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/minimal}/scripts/monitors.sh\"",
    "interval": 86400
  }
}
