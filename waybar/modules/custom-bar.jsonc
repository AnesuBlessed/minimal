{
  "custom/bar": {
    "format": "",
    "rotate": 0,
    "tooltip-format": "Left: Cycle Layout (01 / Custom) | Right: Reload Bar | Middle: Select Bar",
    "on-click": "\"$MINIMAL_ROOT/scripts/bar.sh\" next",
    "on-click-right": "\"$MINIMAL_ROOT/scripts/bar.sh\" reload",
    "on-click-middle": "\"$MINIMAL_ROOT/scripts/bar.sh\" select",
    "interval": 86400,
    "tooltip": true
  }
}
