{
    "bluetooth": {
        "format": "\uf293",
        "format-disabled": "\udb80\udcb2",
        "format-off": "\udb80\udcb2",
        "format-on": "\uf293",
        "format-no-controller": "\udb80\udcb2",
        "format-connected": "\uf293",
        "format-connected-battery": "\uf293",
        "on-click": "\"${MINIMAL_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/minimal}/scripts/control-center.sh\" bluetooth",
        "on-click-right": "\"${MINIMAL_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/minimal}/scripts/control-center-actions.sh\" bt-toggle",
        "tooltip-format": "Bluetooth: {status}\nClick to open settings",
        "tooltip-format-disabled": "Bluetooth disabled\nClick to open settings",
        "tooltip-format-off": "Bluetooth off\nClick to open settings",
        "tooltip-format-on": "Bluetooth on \u00b7 no devices connected\nClick to open settings",
        "tooltip-format-no-controller": "No Bluetooth controller available",
        "tooltip-format-connected": "{controller_alias}\n{num_connections} connected\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias} \u00b7 {device_battery_percentage}%"
    }
}
