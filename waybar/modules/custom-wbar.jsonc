{
    "custom/wbar": {
        "format": "",
        "rotate": 0,
        "tooltip-format": "Left: Next Bar | Right: Prev Bar | Middle: Select Bar",
        "on-click": "$MINIMAL_ROOT/scripts/wbar-switch.sh next",
        "on-click-right": "$MINIMAL_ROOT/scripts/wbar-switch.sh prev",
        "on-click-middle": "$MINIMAL_ROOT/scripts/wbar-switch.sh select",
        "interval": 86400,
        "tooltip": true
    }
}
