{
  "custom/wbar": {
    "format": "",
    "rotate": 0,
    "tooltip-format": "Reload Bar (Click) | Toggle Bar (Right-click)",
    "on-click": "\"${MINIMAL_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/minimal}/scripts/waybar.sh\" --reload",
    "on-click-right": "\"${MINIMAL_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/minimal}/scripts/waybar.sh\" --toggle",
    "interval": 86400,
    "tooltip": true
  }
}