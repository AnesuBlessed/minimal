{
  "image#wallpaper": {
    "exec": "cat \"${XDG_STATE_HOME:-$HOME/.local/state}/minimal/current_wallpaper\" 2>/dev/null || printf \"\\n\"",
    "on-click": "\"$MINIMAL_ROOT/scripts/wallpaper.sh\" --menu",
    "on-click-right": "\"$MINIMAL_ROOT/scripts/bar.sh\" select",
    "tooltip": true,
    "signal": 19,
    "interval": 5
  }
}
