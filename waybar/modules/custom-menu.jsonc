{
  "custom/menu": {
    "format": "󰍜",
    "tooltip": true,
    "tooltip-format": "App Launcher (Left-click) | Reload Bar (Right-click)",
    "on-click": "\"${MINIMAL_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/minimal}/scripts/launcher.sh\"",
    "on-click-right": "\"${MINIMAL_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/minimal}/scripts/waybar.sh\" --reload",
    "interval": 86400
  }
}
