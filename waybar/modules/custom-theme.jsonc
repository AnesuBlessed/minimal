{
  "custom/theme": {
    "format": "",
    "rotate": 0,
    "tooltip-format": "Switch Theme / Wallpaper",
    "on-click": "\"${MINIMAL_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/minimal}/scripts/wallchange.sh\" --random",
    "on-click-right": "\"${MINIMAL_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/minimal}/scripts/wallchange.sh\"",
    "interval": 86400,
    "tooltip": true
  }
}
