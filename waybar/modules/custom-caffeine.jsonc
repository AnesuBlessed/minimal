{
  "custom/caffeine": {
    "return-type": "json",
    "format": "{}",
    "rotate": 0,
    "justify": "center",
    "exec": "\"${MINIMAL_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/minimal}/scripts/caffeine.sh\" status",
    "on-click": "\"${MINIMAL_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/minimal}/scripts/caffeine.sh\" toggle",
    "interval": 30,
    "tooltip": true
  }
}
