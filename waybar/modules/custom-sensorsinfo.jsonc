{
  "custom/sensorsinfo": {
    "exec": "python3 -c \"import psutil; t=psutil.sensors_temperatures(); val=t.get('coretemp', t.get('acpitz', [None]))[0]; cur=val.current if val else 0; print('{\\\"text\\\":\\\"󰔏 ' + str(round(cur)) + '°C\\\",\\\"tooltip\\\":\\\"Temperature: ' + str(cur) + '°C\\\"}')\"",
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "interval": 5
  }
}