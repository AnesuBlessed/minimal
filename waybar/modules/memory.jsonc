{
  "memory": {
    "states": {
      "warning": 75,
      "critical": 90
    },
    "interval": 15,
    "format": "󰾆 {used:0.1f}G",
    "format-alt": "󰾆 {percentage}%",
    "rotate": 0,
    "tooltip": true,
    "tooltip-format": "Memory: {used:0.2f}GiB / {total:0.2f}GiB ({percentage}%)\nSwap: {swapUsed:0.2f}GiB / {swapTotal:0.2f}GiB ({swapPercentage}%)"
  }
}
