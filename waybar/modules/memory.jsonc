{
  "memory": {
    "states": {
      "critical": 90,
      "high": 60,
      "medium": 30,
      "low": 0
    },
    "interval": 30,
    "format": "{icon} {used:0.1f}G",
    "format-alt": "{icon} {percentage}%",
    "format-icons": {
      "critical": "",
      "high": "󰓅",
      "medium": "󰾅",
      "low": "󰾆"
    },
    "rotate": 0,
    "max-length": 10,
    "tooltip": true,
    "tooltip-format": "󰾆 Memory usage: {percentage}%\n Used: {used:0.2f} GiB / {total:0.2f} GiB\n󰍛 Available: {avail:0.2f} GiB\n Swap used: {swapUsed:0.2f} GiB / {swapTotal:0.2f} GiB ({swapPercentage}%)"
  }
}
