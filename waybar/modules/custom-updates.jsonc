{
  "custom/updates": {
    "exec": "\"${MINIMAL_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/minimal}/scripts/updates.sh\"",
    "return-type": "json",
    "format": "{}",
    "rotate": 0,
    "on-click": "\"${MINIMAL_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/minimal}/scripts/terminal.sh\" sudo pacman -Syu",
    "interval": 3600,
    "tooltip": true
  }
}
