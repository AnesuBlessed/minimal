{
  "group/eyecare": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": "0.5",
      "children-class": "eyecare-drawer",
      "transition-left-to-right": false,
      "click-to-reveal": false
    },
    "modules": [
      "backlight#eyecare",
      "custom/hyprsunset"
    ]
  },
  "backlight#eyecare": {
    "format": "<span size='large'>{icon}</span>",
    "format-icons": ["", "", "", "", "", "", "", "", ""],
    "on-click": "bash -c 'pidof hyprsunset >/dev/null && pkill hyprsunset || (hyprsunset -t 4500 >/dev/null 2>&1 &)'",
    "on-scroll-up": "brightnessctl set 5%+",
    "on-scroll-down": "brightnessctl set 5%-",
    "tooltip": true,
    "min-length": 2,
    "tooltip-format": "Backlight: {icon} {percent}%\n\n󰺤 Scroll to change brightness\n󰳾 Click to toggle night light"
  }
}
