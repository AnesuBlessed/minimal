{
  "group/eyecare": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 120,
      "children-class": "eyecare-drawer",
      "transition-left-to-right": false,
      "click-to-reveal": false
    },
    "modules": [
      "backlight#eyecare",
      "custom/hyprsunset"
    ]
  },
  "backlight#eyecare": {
    "format": "<span size='large'>{icon}</span>",
    "format-icons": ["", "", "", "", "", "", "", "", ""],
    "on-click": "\"${MINIMAL_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/minimal}/scripts/night-light.sh\"",
    "on-scroll-up": "\"${MINIMAL_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/minimal}/scripts/media.sh\" brightness up",
    "on-scroll-down": "\"${MINIMAL_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/minimal}/scripts/media.sh\" brightness down",
    "tooltip": true,
    "min-length": 2,
    "tooltip-format": "Backlight: {icon} {percent}%\n\n󰺤 Scroll to change brightness\n󰳾 Click to toggle night light"
  }
}
