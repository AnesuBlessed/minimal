{
  "custom/dunst": {
    "format": "{}",
    "rotate": 0,
    "return-type": "json",
    "exec": "bash -c 'makoctl mode 2>/dev/null | grep -q \"dnd\" && echo \"{\\\"text\\\":\\\"\\\",\\\"class\\\":\\\"dnd\\\",\\\"tooltip\\\":\\\"Do Not Disturb (Active)\\\"}\" || echo \"{\\\"text\\\":\\\"\\\",\\\"class\\\":\\\"none\\\",\\\"tooltip\\\":\\\"Notifications Active\\\"}\"'",
    "on-click": "makoctl mode -t dnd",
    "on-click-middle": "makoctl dismiss -a",
    "on-click-right": "${MINIMAL_ROOT:-$HOME/.config/minimal}/scripts/notifications.sh dnd",
    "interval": 2,
    "tooltip": true
  }
}
