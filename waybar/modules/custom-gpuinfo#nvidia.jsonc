{
  "custom/gpuinfo#nvidia": {
    "exec-if": "which nvidia-smi >/dev/null 2>&1 && nvidia-smi >/dev/null 2>&1",
    "exec": "nvidia-smi --query-gpu=utilization.gpu,temperature.gpu --format=csv,noheader,nounits | awk -F', ' '{printf \"{\\\"text\\\":\\\"󰢮 %s%%\\\",\\\"tooltip\\\":\\\"NVIDIA GPU: %s%% (%s°C)\\\"}\\n\", $1, $1, $2}'",
    "return-type": "json",
    "format": "{}",
    "rotate": 0,
    "interval": 5,
    "tooltip": true
  }
}
