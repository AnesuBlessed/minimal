{
    // =========================================================================
    //  MINIMAL WAYBAR — REFINED DISCRETE ISLAND PILLS (HYDE COMPATIBLE)
    // =========================================================================
    //  - Exact HyDE pill layout matching reference screenshots
    //  - Center island: Workspaces + Active Window Title
    //  - Expanding clock with date toggle on click
    //  - Proper battery icon with charging bolt indication
    //  - Native WirePlumber audio, mic, and backlight controls
    //  - Power button launches HyDE wlogout
    // =========================================================================

    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 0,
    "margin-top": 2,
    "margin-left": 10,
    "margin-right": 10,

    "modules-left": [
        "group/hardware",
        "group/time-caffeine"
    ],

    "modules-center": [
        "group/center"
    ],

    "modules-right": [
        "group/controls",
        "group/connectivity",
        "custom/power"
    ],

    // --- Pill Groups ---
    "group/hardware": {
        "orientation": "horizontal",
        "modules": ["cpu", "memory"]
    },

    "group/time-caffeine": {
        "orientation": "horizontal",
        "modules": ["idle_inhibitor", "clock"]
    },

    "group/center": {
        "orientation": "horizontal",
        "modules": ["hyprland/workspaces", "hyprland/window"]
    },

    "group/controls": {
        "orientation": "horizontal",
        "modules": ["backlight", "wireplumber#sink", "wireplumber#source"]
    },

    "group/connectivity": {
        "orientation": "horizontal",
        "modules": ["network", "bluetooth", "battery"]
    },

    // --- Left Pill 1: Hardware Stats ---
    "cpu": {
        "interval": 15,
        "format": "󰍛 {usage}%",
        "tooltip": true
    },

    "memory": {
        "interval": 30,
        "format": "󰾆 {used:0.1f}G",
        "tooltip": true,
        "tooltip-format": "RAM: {used:0.2f}GiB / {total:0.2f}GiB ({percentage}%)"
    },

    // --- Left Pill 2: Caffeine Mode & Expanding Clock ---
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰅶",
            "deactivated": "󰛊"
        },
        "tooltip": true,
        "tooltip-format-activated": "Caffeine Active (Screen will not sleep)",
        "tooltip-format-deactivated": "Caffeine Inactive"
    },

    "clock": {
        "interval": 1,
        "format": "{:%H:%M:%S}",
        "format-alt": "󰃭 {:%a, %d %b %Y}",
        "tooltip": true,
        "tooltip-format": "<big><b>{:%A, %d %B %Y}</b></big>\n\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#bcb8ef'><b>{}</b></span>",
                "days": "<span color='#f4f4f5'><b>{}</b></span>",
                "weeks": "<span color='#828292'><b>W{}</b></span>",
                "weekdays": "<span color='#bcb8ef'><b>{}</b></span>",
                "today": "<span color='#181726' background='#bcb8ef'><b>{}</b></span>"
            }
        }
    },

    // --- Center Pill: Workspaces + Window Title ---
    "hyprland/workspaces": {
        "all-outputs": true,
        "disable-scroll": false,
        "active-only": false,
        "format": "{name}",
        "persistent-workspaces": {
            "*": 4
        }
    },

    "hyprland/window": {
        "format": "<b>{title}</b>",
        "max-length": 25,
        "separate-outputs": true,
        "rewrite": {
            "(.*) — Mozilla Firefox": "$1 󰈹",
            "(.*) - Dolphin": "$1 󰉋",
            "(.*) - Visual Studio Code": "$1 󰨞",
            "(.*) - Foot": "$1 󰞷",
            "^$": ""
        }
    },

    // --- Right Pill 1: Media & Controls ---
    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "on-scroll-up": "\"${XDG_CONFIG_HOME:-$HOME/.config}/minimal/scripts/media.sh\" brightness up",
        "on-scroll-down": "\"${XDG_CONFIG_HOME:-$HOME/.config}/minimal/scripts/media.sh\" brightness down",
        "tooltip": false
    },

    "wireplumber#sink": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": ["󰕿", "󰖀", "󰕾"],
        "on-click": "pavucontrol",
        "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-",
        "tooltip": true,
        "tooltip-format": "Volume: {volume}%"
    },

    "wireplumber#source": {
        "node-type": "Audio/Source",
        "format": "󰍬",
        "format-muted": "󰍭",
        "tooltip": true,
        "tooltip-format": "Microphone: {volume}%",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SOURCE@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 2%-"
    },

    // --- Right Pill 2: Connectivity & Battery ---
    "network": {
        "interval": 15,
        "format-wifi": "󰤨",
        "format-ethernet": "󰈀",
        "format-linked": "󰈀",
        "format-disconnected": "󰤭",
        "tooltip": true,
        "tooltip-format-wifi": "󰤨  {essid} ({signalStrength}%)\nIP: {ipaddr}",
        "tooltip-format-ethernet": "󰈀  Wired ({ifname})\nIP: {ipaddr}",
        "tooltip-format-disconnected": "󰤭  Disconnected",
        "on-click": "nm-connection-editor"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-connected": "󰂱 {num_connections}",
        "tooltip-format": "Bluetooth: {status}",
        "on-click": "footclient -e bluetuith || foot -e bluetuith || blueman-manager"
    },

    "battery": {
        "interval": 15,
        "states": {
            "warning": 25,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰂄 {capacity}%",
        "format-full": "󰁹 󱐋 {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip": true,
        "tooltip-format": "{time}\nPower draw: {power}W\nHealth: {health}%"
    },

    // --- Right Pill 3: Power ---
    "custom/power": {
        "format": "",
        "tooltip": true,
        "tooltip-format": "Power Menu (HyDE / wlogout)",
        "on-click": "\"${XDG_CONFIG_HOME:-$HOME/.config}/minimal/scripts/powermenu.sh\""
    }
}
