{
    // =========================================================================
    //  MINIMAL WAYBAR — MODULAR FLOATING ISLAND ARCHITECTURE
    // =========================================================================
    //  - Ported from HyDE's modular Waybar library
    //  - Pure event-driven, zero-bloat standalone implementation
    //  - 100% independent of hyde-shell, wallbash, or python theme switchers
    // =========================================================================

    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 0,
    "margin-top": 2,
    "margin-left": 8,
    "margin-right": 8,

    // Modular include library
    "include": [
        "$HOME/.config/waybar/modules/*.jsonc",
        "modules/*.jsonc"
    ],

    // Clean, balanced 3-island layout
    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "pulseaudio",
        "backlight",
        "battery",
        "cpu",
        "memory",
        "network",
        "tray",
        "custom/powermenu"
    ]
}
