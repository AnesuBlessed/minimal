{
  "layer": "top",
  "output": [
    "*"
  ],
  "height": 10,
  "exclusive": true,
  "passthrough": false,
  "reload_style_on_change": true,
  "include": [
    "../includes/includes.json"
  ],
  "modules-left": [
    "group/pill#left1",
    "group/pill#left2"
  ],
  "group/pill#left1": {
    "orientation": "inherit",
    "modules": [
      "custom/power",
      "custom/menu",
      "custom/clipboard",
      "custom/bar",
      "custom/wallpaper"
    ]
  },
  "group/pill#left2": {
    "orientation": "inherit",
    "modules": [
      "idle_inhibitor",
      "clock",
      "mpris#spotify"
    ]
  },
  "modules-center": [
    "group/pill#center"
  ],
  "group/pill#center": {
    "orientation": "inherit",
    "modules": [
      "wlr/taskbar"
    ]
  },
  "modules-right": [
    "group/pill#right1",
    "group/pill#right2"
  ],
  "group/pill#right1": {
    "orientation": "inherit",
    "modules": [
      "privacy",
      "tray"
    ]
  },
  "group/pill#right2": {
    "orientation": "inherit",
    "modules": [
      "backlight",
      "network",
      "pulseaudio",
      "pulseaudio#microphone"
    ]
  }
}
