{
  "layer": "top",
  "output": [
    "*"
  ],
  "height": 10,
  "exclusive": true,
  "passthrough": false,
  "reload_style_on_change": true,
  "include": [
    "../includes/includes.json"
  ],
  "modules-left": [
    "group/pill#left"
  ],
  "group/pill#left": {
    "orientation": "inherit",
    "modules": [
      "hyprland/workspaces"
    ]
  },
  "modules-center": [
    "group/pill#center"
  ],
  "group/pill#center": {
    "orientation": "inherit",
    "modules": [
      "mpris",
      "idle_inhibitor",
      "clock"
    ]
  },
  "modules-right": [
    "group/pill#right"
  ],
  "group/pill#right": {
    "orientation": "inherit",
    "modules": [
      "backlight",
      "pulseaudio",
      "pulseaudio#microphone",
      "tray",
      "battery",
      "custom/keybinds",
      "custom/clipboard",
      "custom/menu",
      "custom/power"
    ]
  }
}
