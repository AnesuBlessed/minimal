{
  "layer": "top",
  "output": [
    "*"
  ],
  "height": 10,
  "exclusive": true,
  "passthrough": false,
  "reload_style_on_change": true,
  "include": [
    "../includes/includes.json"
  ],
  "modules-left": [
    "group/pill#left"
  ],
  "group/pill#left": {
    "orientation": "inherit",
    "modules": [
      "hyprland/workspaces",
      "wlr/taskbar"
    ]
  },
  "modules-center": [
    "group/pill#center"
  ],
  "group/pill#center": {
    "orientation": "inherit",
    "modules": [
      "idle_inhibitor",
      "clock",
      "custom/updates",
      "custom/keybinds"
    ]
  },
  "modules-right": [
    "group/pill#right"
  ],
  "group/pill#right": {
    "orientation": "inherit",
    "modules": [
      "privacy",
      "backlight",
      "tray",
      "network",
      "bluetooth",
      "pulseaudio",
      "pulseaudio#microphone",
      "battery",
      "cpu",
      "temperature",
      "custom/mako",
      "custom/menu"
    ]
  }
}
