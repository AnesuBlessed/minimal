/* Minimal — wallpaper, mode rail, and searchable application list. */
configuration {
    modi: "drun,window,run";
    show-icons: true;
    display-drun: "";
    display-window: "";
    display-run: "";
    drun-display-format: "{name}";
    window-format: "{w}{t}";
    font: "JetBrainsMono Nerd Font 10";
    icon-theme: "Adwaita";
}
@theme "theme.rasi"
window {
    width: 85%; height: 560px;
    border: 2px; border-radius: 20px;
    border-color: @main-br; background-color: @main-bg;
}
mainbox {
    orientation: horizontal; spacing: 0px; padding: 0px;
    children: [ "box-wallpaper", "box-content" ];
    background-color: transparent;
}
box-wallpaper {
    orientation: horizontal; width: 32%; expand: false;
    children: [ "mode-switcher" ];
    background-image: none; background-color: #182234;
    border-radius: 18px 0px 0px 18px;
}
mode-switcher {
    orientation: vertical; width: 56px; expand: false;
    padding: 100px 8px; spacing: 12px;
    background-color: #0f1a2ab3;
}
button {
    padding: 12px 0px; border-radius: 20px;
    background-color: @main-bg; text-color: @main-fg;
}
button selected { background-color: @select-bg; text-color: @select-fg; }
box-content {
    orientation: vertical; spacing: 16px; padding: 24px;
    children: [ "inputbar", "listview" ]; background-color: transparent;
}
inputbar {
    expand: false; padding: 12px; border: 1px; border-radius: 12px;
    border-color: @main-br; background-color: #182234;
    children: [ "entry" ];
}
entry {
    enabled: true; placeholder: "Search applications...";
    placeholder-color: #AAC7F0; text-color: @main-fg;
    background-color: transparent;
}
listview {
    columns: 1; lines: 6; spacing: 6px; cycle: true;
    dynamic: false; fixed-height: false; expand: true;
    scrollbar: false; background-color: transparent;
}
element {
    padding: 10px 12px; spacing: 12px; border-radius: 12px;
    background-color: transparent; text-color: @main-fg;
}
element selected.normal { background-color: @select-bg; text-color: @select-fg; }
element-icon { size: 28px; background-color: transparent; }
element-text { vertical-align: 0.5; background-color: transparent; text-color: inherit; }
error-message { children: [ "textbox" ]; background-color: @main-bg; }
textbox { padding: 12px; background-color: transparent; text-color: @main-fg; }
@media (max-height: 800px) {
    window { height: 80%; }
    box-content { padding: 18px; }
    mode-switcher { padding: 60px 8px; }
}
@media (max-width: 1000px) {
    window { width: 92%; }
    box-wallpaper { width: 24%; }
    box-content { padding: 12px; }
}
