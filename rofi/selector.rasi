/**
 *  MINIMAL — SELECTOR MENU THEME (WALLPAPERS, LAYOUTS, POWER)
 *  Obsidian glass scrim, wallpaper banner frame, dynamic theme tokens.
 */

configuration {
    show-icons:                  false;
    font:                        "JetBrainsMono Nerd Font 10";
}

@theme "theme.rasi"

window {
    width:                       360px;
    transparency:                "real";
    fullscreen:                  false;
    enabled:                     true;
    cursor:                      "default";
    spacing:                     0px;
    padding:                     0px;
    border:                      2px;
    border-radius:               18px;
    border-color:                @main-br;
    background-color:            @main-bg;
}

mainbox {
    enabled:                     true;
    spacing:                     0px;
    padding:                     8px;
    orientation:                 vertical;
    children:                    [ "wallbox" , "listbox" ];
    background-color:            transparent;
}

// Wallpaper Banner & Filter Header //
wallbox {
    spacing:                     0px;
    padding:                     0px;
    expand:                      false;
    orientation:                 horizontal;
    background-color:            transparent;
    background-image:            url("~/.cache/minimal/wall.blur", width);
    border-radius:               12px;
    children:                    [ "wallframe" , "inputbar" ];
}

wallframe {
    width:                       68px;
    spacing:                     0px;
    padding:                     0px;
    expand:                      false;
    background-color:            transparent;
    background-image:            url("~/.cache/minimal/wall.quad", width);
    border-radius:               12px 0px 0px 12px;
}

inputbar {
    enabled:                     true;
    padding:                     10px 14px;
    spacing:                     8px;
    children:                    [ "prompt" , "entry" ];
    background-color:            @main-ex;
    border-radius:               0px 12px 12px 0px;
    expand:                      true;
}

prompt {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @main-fg;
    vertical-align:              0.5;
}

entry {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @main-fg;
    cursor:                      text;
    placeholder:                 "Filter...";
    placeholder-color:           @main-fg;
    vertical-align:              0.5;
}

// List of Choices //
listbox {
    spacing:                     0px;
    padding:                     6px 0px 0px 0px;
    orientation:                 vertical;
    children:                    [ "listview" ];
    background-color:            transparent;
}

listview {
    enabled:                     true;
    spacing:                     4px;
    padding:                     4px;
    columns:                     1;
    lines:                       8;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    fixed-height:                true;
    fixed-columns:               true;
    cursor:                      "default";
    background-color:            transparent;
    text-color:                  @main-fg;
}

element {
    enabled:                     true;
    spacing:                     10px;
    padding:                     8px 14px;
    cursor:                      pointer;
    background-color:            transparent;
    text-color:                  @main-fg;
    border-radius:               10px;
}

element selected.normal {
    background-color:            @select-bg;
    text-color:                  @select-fg;
}

element-text {
    vertical-align:              0.5;
    horizontal-align:            0.0;
    cursor:                      inherit;
    background-color:            transparent;
    text-color:                  inherit;
}

@media (max-width: 600px) {
    window { width: 90%; }
}
