{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "$XDG_CONFIG_HOME/fastfetch/assets/current.png",
    "type": "sixel",
    "height": 18,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": " : "
  },
  "modules": [
    {
      "type": "custom",
      "format": "  \udb80\udc58 : Minimal Rice \u2014 Performance Core Active"
    },
    {
      "type": "custom",
      "format": "\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510"
    },
    {
      "type": "chassis",
      "key": "  \udb80\uddfa Chassis",
      "format": "{1} {2} {3}",
      "keyColor": "blue"
    },
    {
      "type": "os",
      "key": "  \udb82\udcc7 OS",
      "format": "{2}",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": "  \ue272 Kernel",
      "format": "{2}",
      "keyColor": "green"
    },
    {
      "type": "packages",
      "key": "  \udb80\udfd7 Packages",
      "keyColor": "green"
    },
    {
      "type": "display",
      "key": "  \udb80\udf79 Display",
      "format": "{1}x{2} @ {3}Hz [{7}]",
      "keyColor": "yellow"
    },
    {
      "type": "terminal",
      "key": "  \uf120 Terminal",
      "keyColor": "yellow"
    },
    {
      "type": "wm",
      "key": "  \udb85\uddc3 WM",
      "format": "{2}",
      "keyColor": "magenta"
    },
    {
      "type": "custom",
      "format": "\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518"
    },
    "break",
    {
      "type": "title",
      "key": "  \uedc5 User",
      "format": "{6} @ {8}",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "format": "\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510"
    },
    {
      "type": "cpu",
      "format": "{1} @ {7}",
      "key": "  \uf4bc CPU",
      "keyColor": "blue"
    },
    {
      "type": "gpu",
      "format": "{name:-28}",
      "key": "  \udb80\udeb4 GPU",
      "keyColor": "blue"
    },
    {
      "type": "gpu",
      "format": "{driver}",
      "key": "  \uf029 GPU Driver",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "  \udb80\udf5b Memory",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "  \udb86\udd9f OS Age",
      "folders": "/",
      "format": "{days} days",
      "keyColor": "magenta"
    },
    {
      "type": "uptime",
      "key": "  \udb86\uded0 Uptime",
      "keyColor": "magenta"
    },
    {
      "type": "custom",
      "format": "\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
