{
    "label": "lock",
    "action": "IFS=; ${MINIMAL_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/minimal}/scripts/power-action.sh lock &",
    "text": "Lock",
    "keybind": "l"
}
